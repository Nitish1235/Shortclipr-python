# ── Supabase (DB only — not used for auth) ─────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Google Auth (OAuth — for login) ───────────────────────────
# Get from Google Cloud Console → APIs → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── JWT Secret (sign your own tokens after Google OAuth) ───────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-signing-key-min-32-chars

# ── Upstash Redis ──────────────────────────────────────────────
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
WHISPER_MODEL=whisper-1

# ── Google Cloud Storage ───────────────────────────────────────
GCS_BUCKET_NAME=shortclipr-clips
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Brainrot Clips Maker — fill these in before running Phase 1 ─
BRAINROT_GCS_BUCKET_NAME=shortclipr-brainrot-assets
UNREALSPEECH_API_KEY=
LEMONFOX_API_KEY=

# ── Dodo Payments ─────────────────────────────────────────────
# Get API key from: app.dodopayments.com → Settings → API Keys
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_SECRET=your-dodo-webhook-secret

# Defaults to sandbox (https://test.dodopayments.com) if left unset — this
# is the one Dodo setting that ISN'T obvious to remember to set. A real API
# key + real product IDs with this still unset means checkout silently hits
# the sandbox API, not live. Set to https://live.dodopayments.com for real
# payments (and set VITE_DODO_MODE=live on the frontend build to match —
# see src/components/Pricing.jsx).
DODO_API_BASE=https://live.dodopayments.com

# Product IDs — these variable names must match app/core/config.py exactly
# (the old names below — *_MONTHLY/*_ANNUAL — matched nothing there, so
# every one of these silently defaulted to "" and checkout 503'd for every
# plan). Real product IDs below are from the actual Dodo dashboard
# (app.dodopayments.com → Products) — these 5 back the "legacy slider"
# tiers in plan_limits.py, the ones actually live in Dodo right now.
# ── Current pricing (3 tiers) — NOT yet created as Dodo products ──
DODO_PRODUCT_STARTER_30=
DODO_PRODUCT_GROWTH_100=
DODO_PRODUCT_UNLIMITED=
# ── Legacy slider tiers — real products, from your Dodo dashboard ─
DODO_PRODUCT_STARTER_100=pdt_0NgeHduLpMYA9bXMHQopz    # Shortclipr Starter — $10
DODO_PRODUCT_STARTER_250=pdt_0NgeHuMEjTGZ5NT8y6n0M    # Shortclipr Starter — $25
DODO_PRODUCT_PRO_500=pdt_0NgeITaaybng8nbFGGQVJ        # Shortclipr Pro — $45
DODO_PRODUCT_PRO_1000=pdt_0NgeIeZ1xzG2zp0LrON1E       # Shortclipr Pro — $79
DODO_PRODUCT_PRO_2000=pdt_0NgeIyALtdIRfRW1CrXc1       # Shortclipr Max — $145
# ── Brainrot — fully separate product, own plan/credits pool ──────
# No real Dodo products created yet — checkout 503s "not configured"
# until you create these in the dashboard and fill in the IDs below.
DODO_PRODUCT_BRAINROT_STARTER=
DODO_PRODUCT_BRAINROT_GROWTH=
DODO_PRODUCT_BRAINROT_UNLIMITED=

# ── Google Cloud Storage ───────────────────────────────────────
GCS_BUCKET_NAME=shortclipr-clips
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com
# Path to service account JSON (or use Workload Identity on Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

