FROM python:3.12-slim AS python-builder
WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM node:22-bookworm-slim AS renderer-builder
WORKDIR /drawn-by-code
COPY drawn_by_code/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg chromium nodejs fontconfig fonts-liberation fonts-noto-core fonts-noto-extra ca-certificates \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=python-builder /install /usr/local
COPY --from=renderer-builder /drawn-by-code/node_modules /app/drawn_by_code/node_modules
COPY drawn_by_code/ /app/drawn_by_code/
# Fail the image build if the JavaScript AST linker or its installed parser/scope
# dependencies cannot execute. This prevents deploying a worker without the linker.
RUN node --check /app/drawn_by_code/engine/validate-scene.mjs \
    && printf '%s' 'function drawPropDeck(g, x) { g.fillRect(x, 0, 10, 2); } function drawShot_0(g, t, env, absoluteTime) { drawPropDeck(g, 0); } Motion.scene({draw(g, t, env) { drawShot_0(g, t, env, t); }});' > /tmp/linker-smoke-scene.js \
    && printf '%s' '{"schema_version":1,"functions":[{"name":"drawPropDeck","signature":"function drawPropDeck(g, x)","dependencies":[],"required_by_shots":[0]}],"shots":[{"index":0,"required_helpers":["drawPropDeck"]}]}' > /tmp/linker-smoke-manifest.json \
    && node /app/drawn_by_code/engine/validate-scene.mjs /tmp/linker-smoke-scene.js /tmp/linker-smoke-manifest.json \
    && printf '%s' 'function drawShot_0(g, t, env, absoluteTime) { drawCharacter(g, 10, 20, 1, "idle", "neutral"); } Motion.scene({draw(g, t, env) { drawShot_0(g, 0, env, 0); }});' > /tmp/linker-unresolved-scene.js \
    && printf '%s' '{"schema_version":1,"functions":[],"shots":[{"index":0,"required_helpers":[]}]}' > /tmp/linker-empty-manifest.json \
    && if node /app/drawn_by_code/engine/validate-scene.mjs /tmp/linker-unresolved-scene.js /tmp/linker-empty-manifest.json > /tmp/linker-negative.log 2>&1; then echo 'Linker incorrectly accepted undefined drawCharacter helper' >&2; exit 1; else grep -q 'drawCharacter' /tmp/linker-negative.log; fi \
    && printf '%s' 'Motion.scene({draw(g, t, env) { g.fillRect(0, 0, 1, 1); }});' > /tmp/linker-missing-shot-scene.js \
    && if node /app/drawn_by_code/engine/validate-scene.mjs /tmp/linker-missing-shot-scene.js /tmp/linker-empty-manifest.json > /tmp/linker-missing-shot.log 2>&1; then echo 'Linker incorrectly accepted a missing drawShot_0 implementation' >&2; exit 1; else grep -q 'Missing canonical shot implementations' /tmp/linker-missing-shot.log; fi
COPY app/ /app/app/
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh
ENV PORT=8080 \
    SERVICE_ROLE=ffmpeg-worker \
    DRAWN_BY_CODE_ROOT=/app/drawn_by_code \
    CHROME_PATH=/usr/bin/chromium \
    FFMPEG_PATH=/usr/bin/ffmpeg \
    FFPROBE_PATH=/usr/bin/ffprobe \
    DISABLE_TELEMETRY=true
EXPOSE 8080
CMD ["/app/start.sh"]
