# ── Supabase (DB only) ─────────────────────────────────────────
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── JWT Secret ─────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-signing-key-min-32-chars

# ── Upstash Redis (stream URL cache only — NOT a job queue) ────
# Free tier at upstash.com is sufficient
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
WHISPER_MODEL=whisper-1

# ── Google Cloud Storage ───────────────────────────────────────
GCS_BUCKET_NAME=shortclipr-clips
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com
# On Cloud Run: leave GOOGLE_APPLICATION_CREDENTIALS unset
# — the attached Service Account is used automatically.

# ── Dodo Payments ─────────────────────────────────────────────
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_SECRET=your-dodo-webhook-secret

# Product IDs — create in Dodo Dashboard → Products, then copy ID
DODO_PRODUCT_STARTER_100=prd_your_starter_100_id
DODO_PRODUCT_STARTER_250=prd_your_starter_250_id
DODO_PRODUCT_PRO_500=prd_your_pro_500_id
DODO_PRODUCT_PRO_1000=prd_your_pro_1000_id
DODO_PRODUCT_UNLIMITED=prd_your_unlimited_id

# ── InnerTube API (YouTube stream resolution) ─────────────────
INNERTUBE_API_KEY=AIzaSyA8eiZmM1FaSbwzBlGmbW3ILtKBNJI41zQ
INNERTUBE_API_BASE=https://www.youtube.com/youtubei/v1

# ── App Settings ───────────────────────────────────────────────
APP_ENV=production
PORT=8080
LOG_LEVEL=INFO
MAX_CONCURRENT_CLIPS=10
