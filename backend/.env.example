# =============================================================================
# ShortClipr Backend — local development environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# Settings are loaded via app/core/config.py (pydantic-settings) — that file
# is the single source of truth for defaults; this is just the dev template.
# =============================================================================

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development                                          # gates /testing router + dev-only behavior
ADMIN_EMAILS=you@gmail.com                                   # comma-separated — grants admin API access
PORT=8080
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173

# ── Database (Supabase Postgres — connection string only, no Supabase Auth)─
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Google OAuth + JWT ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx                             # needed for backend YouTube-publish flow (UI hidden for now, kept for future)
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-signing-key-min-32-chars
JWT_EXPIRY_DAYS=7
SOCIAL_REDIRECT_URI=http://localhost:8080/social/auth/youtube/callback

# ── TikTok OAuth (Content Posting API v2) ────────────────────────────────
# Register at https://developers.tiktok.com → your app → Login Kit
TIKTOK_CLIENT_KEY=                                           # "Client Key" from TikTok dev portal
TIKTOK_CLIENT_SECRET=                                        # "Client Secret" from TikTok dev portal
# Dev callback: http://localhost:8080/social/auth/tiktok/callback
# Prod callback: https://shortclipr.com/social/auth/tiktok/callback  (register both in portal)
TIKTOK_REDIRECT_URI=http://localhost:8080/social/auth/tiktok/callback

# ── Upstash Redis (stream-URL cache only — NOT a job queue) ────────────────
# Free tier at upstash.com is sufficient
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token
REDIS_STREAM_CACHE_TTL=14400                                 # seconds (default 4h)

# ── OpenAI ────────────────────────────────────────────────────────────────
# Only OPENAI_API_KEY is needed — the clip-detection model is pinned in
# app/pipeline/ai_clipper.py (CLIP_MODEL constant).
OPENAI_API_KEY=sk-...

# ── Google Cloud Storage ───────────────────────────────────────────────────
# REQUIRED — no default so a misconfigured deploy fails loudly.
# Prod example: shortclipr-clips
GCS_BUCKET_NAME=
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com
# On Cloud Run: leave GOOGLE_APPLICATION_CREDENTIALS unset — the attached
# Service Account is used automatically. For local dev, either run
# `gcloud auth application-default login` or point at a service-account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Brainrot Clips Maker — GCS bucket ────────────────────────────────────
# Separate bucket for gameplay background clips + character assets (shared
# library content, not per-user output — see backend/scripts/migrate_characters_to_gcs.py).
# REQUIRED — no default. Prod example: shortclipr-brainrot-assets
BRAINROT_GCS_BUCKET_NAME=

# ── UnrealSpeech (TTS) ─────────────────────────────────────────────────────
UNREALSPEECH_API_KEY=

# ── Lemonfox (TTS) ───────────────────────────────────────────────────────
LEMONFOX_API_KEY=

# ── InnerTube API (YouTube stream/transcript resolution) ──────────────────
INNERTUBE_API_KEY=AIzaSyA8eiZmM1FaSbwzBlGmbW3ILtKBNJI41zQ
INNERTUBE_API_BASE=https://www.youtube.com/youtubei/v1

# ── Proxy (proxy-cheap residential — legacy / admin test lab fallback) ────
# Leave PROXY_HOST empty to run without a proxy (local dev / CI default).
PROXY_HOST=                                                  # e.g. thehub.proxy-cheap.com
PROXY_USER=
PROXY_PASS=
PROXY_PORTS=10001-10007                                      # range or CSV port pool for rotation

# ── Proxy-Seller ISP (10 static ISP proxies — DASH segment downloads) ─────
# Comma-separated "host:port" pairs, one per ISP proxy purchased in the
# Proxy-Seller dashboard (all 10 share the same PROXYSELLER_USER/PASS).
PROXYSELLER_USER=
PROXYSELLER_PASS=
PROXYSELLER_PROXIES=                                         # e.g. 1.2.3.4:10000,5.6.7.8:10000,...

# ── Resend (email broadcast — admin panel) ────────────────────────────────
# Sign up at resend.com, verify your domain, create an API key.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ShortClipr <updates@shortclipr.com>

# ── Dodo Payments ─────────────────────────────────────────────────────────
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_SECRET=your-dodo-webhook-secret
# Defaults to sandbox (https://test.dodopayments.com) — set to
# https://live.dodopayments.com for production.
DODO_API_BASE=https://test.dodopayments.com
# Set true only for local dev when DODO_PAYMENTS_WEBHOOK_SECRET is unset.
# NEVER set in production — fail-closed by default.
DODO_ALLOW_UNSIGNED_WEBHOOKS=false

# Product IDs — create in Dodo Dashboard → Products, then copy ID.
# Each maps 1:1 to a plan key in app/core/plan_limits.py (credits + video quotas).
# ── Current pricing (3 tiers) ──────────────────────────────────────
DODO_PRODUCT_STARTER_30=prd_your_starter_30_id      # $19 — 30 shorts   / 10h video
DODO_PRODUCT_GROWTH_100=prd_your_growth_100_id      # $39 — 100 shorts  / 30h video
DODO_PRODUCT_UNLIMITED=prd_your_unlimited_id        # $99 — unlimited shorts / 100h video
# ── Legacy slider tiers (kept for existing subscribers) ────────────
DODO_PRODUCT_STARTER_100=prd_your_starter_100_id    # $10  — 100 shorts  / 5h video
DODO_PRODUCT_STARTER_250=prd_your_starter_250_id    # $25  — 250 shorts  / 10h video
DODO_PRODUCT_PRO_500=prd_your_pro_500_id            # $45  — 500 shorts  / 18h video
DODO_PRODUCT_PRO_1000=prd_your_pro_1000_id          # $79  — 1000 shorts / 35h video
DODO_PRODUCT_PRO_2000=prd_your_pro_2000_id          # $145 — 2000 shorts / 60h video

# ── App / Pipeline tuning ──────────────────────────────────────────────────
MAX_CONCURRENT_CLIPS=10            # asyncio semaphore for parallel FFmpeg encodes
MAX_CONCURRENT_JOBS_PER_USER=1     # one job at a time — pins the user's IP + prevents proxy IP collisions
MAX_CONCURRENT_BRAINROT_JOBS_PER_USER=2  # brainrot jobs don't use YouTube proxies, higher cap ok

# ── Shared secret (API ↔ watcher ↔ all workers) ───────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Must be byte-identical on every service. Required in split-worker mode.
INTERNAL_TASK_SECRET=

# ── Worker dispatch (optional — activates split-worker mode) ──────────────
# Leave all *_WORKER_URLS vars empty to run the full pipeline in-process
# via asyncio.create_task() (local dev default — no watcher needed).
# In production, set these to activate the split Cloud Run architecture.

# Main pipeline — API stage (metadata, transcript, GPT clip detection):
API_WORKER_URLS=                  # e.g. https://shortclipr-api-worker-us-c1-xxx.run.app
API_WORKER_REGIONS=               # e.g. us-central1   (same count/order as URLs)

# Main pipeline — FFmpeg stage (DASH download, reframe, caption, upload):
FFMPEG_WORKER_URLS=               # e.g. https://shortclipr-ffmpeg-worker-us-c1-xxx.run.app
FFMPEG_WORKER_REGIONS=            # e.g. us-central1

# Brainrot pipeline — dedicated composite render workers (GPT+TTS share API_WORKER_URLS;
# only the FFmpeg composite stage runs on the brainrot workers below).
# Leave empty to fall back to FFMPEG_WORKER_URLS (not recommended in prod —
# heavy brainrot renders can starve Shorts FFmpeg encodes).
BRAINROT_WORKER_URLS=             # e.g. https://shortclipr-brainrot-worker-us-c1-xxx.run.app
BRAINROT_WORKER_REGIONS=          # e.g. us-central1

# ── Watcher / queue tuning (relevant on watcher service; also documented here) ─
# These apply to the watcher's own watcher/config.py — not the API.
RECONCILE_STUCK_MINUTES=10        # API-stage timeout; FFmpeg/brainrot render uses 3×
API_REGION_SOFT_CAP=4             # max concurrent jobs dispatched per API worker URL
FFMPEG_REGION_SOFT_CAP=1          # max concurrent jobs dispatched per FFmpeg worker URL
BRAINROT_REGION_SOFT_CAP=4        # max concurrent renders per brainrot worker URL
WATCHER_POLL_INTERVAL=15          # seconds between poll sweeps (LISTEN/NOTIFY is primary)
