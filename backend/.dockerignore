# Backend .dockerignore
# Prevents unnecessary files from being sent to the Docker build daemon.

.git/
.gitignore
*.md
.env
.env.*
.vscode/
.idea/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.log

# Test files (already deleted, but guard against re-addition)
test_*.py

# Local dev artifacts
*.sqlite
*.db
