# Public API service
APP_ENV=development
# api | api-worker | ffmpeg-worker. Each Cloud Run image sets this itself.
SERVICE_ROLE=api
PORT=8080
LOG_LEVEL=INFO
FRONTEND_URL=http://127.0.0.1:4173
SUPABASE_DB_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
JWT_EXPIRY_DAYS=7
ALLOWED_ORIGINS=[]

# DeepSeek planner/compiler and optional rendered-frame vision QA
DEEPSEEK_API_KEY=
DEEPSEEK_STORY_MODEL=deepseek-flash
DEEPSEEK_ANIMATION_MODEL=deepseek-flash
DEEPSEEK_VISUAL_QA_MODEL=deepseek-flash

# Model planning and scene programming
OPENAI_API_KEY=
OPENAI_LUNA_MODEL=gpt-6-luna
OPENAI_TERRA_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT_LUNA=low
OPENAI_REASONING_EFFORT_TERRA=medium

# Narration
