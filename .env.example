# =============================================================================
# ShortClipr — Environment Variables Reference
# =============================================================================
# This file documents ALL variables needed across every service.
# For production, use the sections below as your checklist.
# Never commit real values — this is a reference template only.
# =============================================================================


# =============================================================================
# 1. FRONTEND (React/Vite — Cloud Run)
# =============================================================================
# These are NOT runtime env vars — they are baked into the static bundle
# at BUILD TIME by Vite. You must set them as Substitution Variables in
# your Cloud Build trigger (Trigger → Edit → Advanced → Substitution Variables)
#
# Variable Name (in trigger)   →  Value
# _VITE_API_URL                →  https://shortclipr-api-<hash>.us-central1.run.app
# _VITE_GOOGLE_CLIENT_ID       →  863331650660-xxxx.apps.googleusercontent.com
# _VITE_DODO_MODE              →  test  (or: live)
#
# For local development only — create a .env file in the project root:
# --------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_DODO_MODE=test


# =============================================================================
# 2. BACKEND — API SERVICE (shortclipr-api — Cloud Run)
# =============================================================================
# Set these in: Cloud Run → shortclipr-api → Edit Revision → Variables & Secrets
#
# [SECRET MANAGER] = store the value in GCP Secret Manager and reference it
# [PLAIN ENV VAR]  = safe to set directly as an environment variable
#
# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=production                              # [PLAIN ENV VAR]
PORT=8080                                       # [PLAIN ENV VAR] — Cloud Run sets this automatically
LOG_LEVEL=INFO                                  # [PLAIN ENV VAR]

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Get from: Supabase → Settings → Database → Connection String → URI
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-region.pooler.supabase.com:5432/postgres
#              ^^^^ [SECRET MANAGER] — contains your DB password

# ── Queue (Upstash Redis) ──────────────────────────────────────────────────
# Get from: console.upstash.com → your DB → REST API tab
UPSTASH_REDIS_URL=https://fine-silkworm-35886.upstash.io   # [PLAIN ENV VAR]
UPSTASH_REDIS_TOKEN=your-upstash-rest-token                # [SECRET MANAGER]

# ── Google OAuth + JWT ─────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID: GCP Console → APIs & Services → Credentials → OAuth 2.0 Client
# JWT_SECRET: run → python -c "import secrets; print(secrets.token_hex(32))"
GOOGLE_CLIENT_ID=863331650660-xxxx.apps.googleusercontent.com  # [PLAIN ENV VAR]
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx                               # [SECRET MANAGER]
JWT_SECRET=your-32-char-random-hex-string                      # [SECRET MANAGER]
SOCIAL_REDIRECT_URI=https://shortclipr-api-<hash>.us-central1.run.app/social/auth/youtube/callback
#                  ^^^^ [PLAIN ENV VAR] — update after deploy

# ── OpenAI ─────────────────────────────────────────────────────────────────
# Get from: platform.openai.com → API Keys
OPENAI_API_KEY=sk-proj-xxxx       # [SECRET MANAGER]
OPENAI_MODEL=gpt-4o               # [PLAIN ENV VAR]
WHISPER_MODEL=whisper-1           # [PLAIN ENV VAR]

# ── Google Cloud Storage ───────────────────────────────────────────────────
# No credentials key needed — Cloud Run uses the attached Service Account
# (IAM → Service Accounts → shortclipr-api → grant Storage Object Admin role)
GCS_BUCKET_NAME=shortclipr-clips                            # [PLAIN ENV VAR]
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com          # [PLAIN ENV VAR]

# ── Dodo Payments ──────────────────────────────────────────────────────────
# Get from: dodopayments.com → Dashboard → API Keys & Products
DODO_PAYMENTS_API_KEY=your-dodo-api-key           # [SECRET MANAGER]
DODO_PAYMENTS_WEBHOOK_SECRET=your-webhook-secret  # [SECRET MANAGER]
DODO_PRODUCT_STARTER_100=prod_xxxx                # [PLAIN ENV VAR]
DODO_PRODUCT_STARTER_250=prod_xxxx                # [PLAIN ENV VAR]
DODO_PRODUCT_PRO_500=prod_xxxx                    # [PLAIN ENV VAR]
DODO_PRODUCT_PRO_1000=prod_xxxx                   # [PLAIN ENV VAR]
DODO_PRODUCT_UNLIMITED=prod_xxxx                  # [PLAIN ENV VAR]


# =============================================================================
# 3. BACKEND — WORKER SERVICE (shortclipr-worker — Cloud Run)
# =============================================================================
# Set these in: Cloud Run → shortclipr-worker → Edit Revision → Variables & Secrets
# The worker shares most vars with the API. Only the essentials are needed.
#
# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=production                              # [PLAIN ENV VAR]
LOG_LEVEL=INFO                                  # [PLAIN ENV VAR]

# ── Database ───────────────────────────────────────────────────────────────
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-region.pooler.supabase.com:5432/postgres
#              ^^^^ [SECRET MANAGER] — same value as API service

# ── Queue ──────────────────────────────────────────────────────────────────
UPSTASH_REDIS_URL=https://fine-silkworm-35886.upstash.io   # [PLAIN ENV VAR]
UPSTASH_REDIS_TOKEN=your-upstash-rest-token                # [SECRET MANAGER]

# ── OpenAI (for AI clip analysis + Whisper transcription) ──────────────────
OPENAI_API_KEY=sk-proj-xxxx   # [SECRET MANAGER]
OPENAI_MODEL=gpt-4o           # [PLAIN ENV VAR]
WHISPER_MODEL=whisper-1       # [PLAIN ENV VAR]

# ── Google Cloud Storage (for uploading finished clips) ────────────────────
# Again — NO credentials file. Attach the shortclipr-api service account
# to the worker service as well, or create a dedicated shortclipr-worker SA.
GCS_BUCKET_NAME=shortclipr-clips                    # [PLAIN ENV VAR]
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com  # [PLAIN ENV VAR]


# =============================================================================
# HOW TO ADD A SECRET MANAGER SECRET (one-time setup per secret)
# =============================================================================
# 1. Go to GCP Console → Secret Manager → + Create Secret
# 2. Name it (e.g. shortclipr-openai-key), paste the value, click Create
# 3. In Cloud Run → Edit Revision → Variables & Secrets tab:
#    → Click "Reference a Secret" instead of "Add Variable"
#    → Select your secret and map it to the env var name (e.g. OPENAI_API_KEY)
# 4. Make sure the Cloud Run service account has the role:
#    "Secret Manager Secret Accessor" in IAM
# =============================================================================
