# =============================================================================
# ShortClipr — Environment Variables Reference
# =============================================================================
# This file documents ALL variables needed across every service.
# For production, use the sections below as your checklist.
# Never commit real values — this is a reference template only.
#
# Architecture note: ShortClipr runs as a SINGLE backend service
# (shortclipr-api on Cloud Run). There is no separate worker — clip jobs
# run in-process via asyncio.create_task() on the same event loop.
# =============================================================================


# =============================================================================
# 1. FRONTEND (React/Vite — Cloud Run, service: shortclipr-frontend)
# =============================================================================
# These are NOT runtime env vars — they are baked into the static bundle
# at BUILD TIME by Vite. Set them as Substitution Variables in your
# Cloud Build trigger (Trigger → Edit → Advanced → Substitution Variables):
#
# Variable Name (in trigger)   →  Value
# _VITE_API_URL                →  https://shortclipr-api-<hash>.us-central1.run.app
# _VITE_GOOGLE_CLIENT_ID       →  863331650660-xxxx.apps.googleusercontent.com
# _VITE_DODO_MODE              →  test  (or: live)
#
# For local development only — create a .env file in the project root:
# --------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_DODO_MODE=test


# =============================================================================
# 2. BACKEND — API SERVICE (shortclipr-api — Cloud Run)
# =============================================================================
# Set these in: Cloud Run → shortclipr-api → Edit Revision → Variables & Secrets
#
# [SECRET MANAGER] = store the value in GCP Secret Manager and reference it
# [PLAIN ENV VAR]  = safe to set directly as an environment variable
#
# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=production                              # [PLAIN ENV VAR] — gates /testing router (dev-only) and debug behavior
ADMIN_EMAILS=you@gmail.com,other@gmail.com      # [PLAIN ENV VAR] — comma-separated list granted admin API access
PORT=8080                                       # [PLAIN ENV VAR] — Cloud Run sets this automatically
LOG_LEVEL=INFO                                  # [PLAIN ENV VAR]
FRONTEND_URL=https://shortclipr.com             # [PLAIN ENV VAR] — used for CORS + OAuth/email redirect links

# ── Database (Supabase PostgreSQL via asyncpg) ─────────────────────────────
# Get from: Supabase → Settings → Database → Connection String → URI
# Note: only the DB connection string is used — auth is handled by our own
# Google OAuth + JWT flow, not Supabase Auth (no SUPABASE_URL/ANON/SERVICE keys).
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-region.pooler.supabase.com:5432/postgres
#              ^^^^ [SECRET MANAGER] — contains your DB password

# ── Redis (Upstash — stream-URL cache only, NOT a job queue) ───────────────
# Get from: console.upstash.com → your DB → REST API tab
UPSTASH_REDIS_URL=https://fine-silkworm-35886.upstash.io   # [PLAIN ENV VAR]
UPSTASH_REDIS_TOKEN=your-upstash-rest-token                # [SECRET MANAGER]
REDIS_STREAM_CACHE_TTL=14400                               # [PLAIN ENV VAR] — seconds (default 4h)

# ── Google OAuth + JWT ─────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID/SECRET: GCP Console → APIs & Services → Credentials → OAuth 2.0 Client
# JWT_SECRET: run → python -c "import secrets; print(secrets.token_hex(32))"
GOOGLE_CLIENT_ID=863331650660-xxxx.apps.googleusercontent.com  # [PLAIN ENV VAR]
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx                               # [SECRET MANAGER] — needed for backend YouTube publish flow (currently hidden in UI, kept for future use)
JWT_SECRET=your-32-char-random-hex-string                      # [SECRET MANAGER]
JWT_EXPIRY_DAYS=7                                              # [PLAIN ENV VAR]
SOCIAL_REDIRECT_URI=https://shortclipr-api-<hash>.us-central1.run.app/social/auth/youtube/callback
#                  ^^^^ [PLAIN ENV VAR] — update after deploy; backend-only, YouTube publish UI is hidden for now

# ── OpenAI ─────────────────────────────────────────────────────────────────
# Get from: platform.openai.com → API Keys
OPENAI_API_KEY=sk-proj-xxxx       # [SECRET MANAGER]
OPENAI_MODEL=gpt-4o               # [PLAIN ENV VAR] — used for clip selection / virality scoring

# ── Google Cloud Storage ───────────────────────────────────────────────────
# No credentials key needed — Cloud Run uses the attached Service Account
# (IAM → Service Accounts → shortclipr-api → grant Storage Object Admin role)
GCS_BUCKET_NAME=shortclipr-clips                            # [PLAIN ENV VAR]
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com          # [PLAIN ENV VAR]

# ── InnerTube (YouTube stream/transcript resolution) ───────────────────────
INNERTUBE_API_KEY=AIzaSyA8eiZmM1FaSbwzBlGmbW3ILtKBNJI41zQ   # [PLAIN ENV VAR] — public web client key
INNERTUBE_API_BASE=https://www.youtube.com/youtubei/v1     # [PLAIN ENV VAR]

# ── Proxy (proxy-cheap residential — for stream/transcript extraction only)
# Downloads are routed direct from Cloud Run's IP whenever the signed stream
# URL isn't IP-bound to the proxy (see app/pipeline/extractor.py), to save
# proxy bandwidth costs. Leave PROXY_HOST empty to run without a proxy
# (local dev / CI) — InnerTube calls will be made directly.
PROXY_HOST=gate.proxy-cheap.com                  # [PLAIN ENV VAR]
PROXY_USER=your-proxy-username                   # [SECRET MANAGER]
PROXY_PASS=your-proxy-password                   # [SECRET MANAGER]
PROXY_PORTS=10001-10007                          # [PLAIN ENV VAR] — range "10001-10007" or CSV "10001,10002,10003"

# ── Dodo Payments ──────────────────────────────────────────────────────────
# Get from: dodopayments.com → Dashboard → API Keys & Products
# 5 tiers matching the pricing slider — see app/core/plan_limits.py for the
# matching credits_limit / video_minutes_limit values for each plan.
DODO_PAYMENTS_API_KEY=your-dodo-api-key           # [SECRET MANAGER]
DODO_PAYMENTS_WEBHOOK_SECRET=your-webhook-secret  # [SECRET MANAGER]
DODO_PRODUCT_STARTER_100=prod_xxxx                # [PLAIN ENV VAR] — $10  / 100 shorts / 5h video
DODO_PRODUCT_STARTER_250=prod_xxxx                # [PLAIN ENV VAR] — $25  / 250 shorts / 10h video
DODO_PRODUCT_PRO_500=prod_xxxx                    # [PLAIN ENV VAR] — $45  / 500 shorts / 18h video
DODO_PRODUCT_PRO_1000=prod_xxxx                   # [PLAIN ENV VAR] — $79  / 1000 shorts / 35h video
DODO_PRODUCT_PRO_2000=prod_xxxx                   # [PLAIN ENV VAR] — $145 / 2000 shorts / 60h video

# ── Worker / Pipeline tuning ───────────────────────────────────────────────
MAX_CONCURRENT_CLIPS=10            # [PLAIN ENV VAR] — asyncio semaphore for parallel FFmpeg encodes
MAX_CONCURRENT_JOBS_PER_USER=2     # [PLAIN ENV VAR] — prevents spam-submission
# Note: per-video duration caps and monthly video-hour quotas are plan-based
# (not env-configurable) — see app/core/plan_limits.py as the source of truth.


# =============================================================================
# HOW TO ADD A SECRET MANAGER SECRET (one-time setup per secret)
# =============================================================================
# 1. Go to GCP Console → Secret Manager → + Create Secret
# 2. Name it (e.g. shortclipr-openai-key), paste the value, click Create
# 3. In Cloud Run → Edit Revision → Variables & Secrets tab:
#    → Click "Reference a Secret" instead of "Add Variable"
#    → Select your secret and map it to the env var name (e.g. OPENAI_API_KEY)
# 4. Make sure the Cloud Run service account has the role:
#    "Secret Manager Secret Accessor" in IAM
# =============================================================================
