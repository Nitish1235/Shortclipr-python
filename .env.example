# Frontend build-time values
VITE_API_URL=http://127.0.0.1:8080
VITE_GOOGLE_CLIENT_ID=
VITE_DODO_MODE=test
VITE_DEMO_MODE=true
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_ID=
